# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins
# 1. Public Frontend (e.g., website publik)
FRONTEND_PUBLIC_URL=http://localhost:3000

# 2. Internal / Admin Frontend (e.g., dashboard internal)
FRONTEND_INTERNAL_URL=http://localhost:5173

# Database Connection (Prisma)
# Format MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Format PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="mysql://root:@localhost:3306/brmp_diy_db"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="24h"
